{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "hal-search": ["../src/index.ts"],
      "hal-search/svg": ["../src/svg-entry.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
